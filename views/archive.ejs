<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Archive | <%= siteName %></title>
  <meta name="description" content="Browse all published articles by year and month.">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            dark: { 900: '#0a0a0a', 800: '#111111', 700: '#1a1a1a', 600: '#222222', 500: '#2a2a2a' }
          },
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-dark-900 text-gray-100 font-sans antialiased min-h-screen flex flex-col">
  <%- include('partials/header') %>
  <main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    <header class="mb-10 border-b border-dark-600 pb-7">
      <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-red-400">From the beginning</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-white">Article Archive</h1>
      <p class="mt-3 text-gray-400"><%= total %> published <%= total === 1 ? 'article' : 'articles' %></p>
    </header>

    <% if (archive.length) { %>
      <div class="space-y-10">
        <% archive.forEach(function(yearGroup) { %>
          <section aria-labelledby="archive-year-<%= yearGroup.year %>">
            <h2 id="archive-year-<%= yearGroup.year %>" class="mb-5 text-2xl font-semibold text-white"><%= yearGroup.year %></h2>
            <div class="space-y-7">
              <% yearGroup.months.forEach(function(monthGroup) { %>
                <section class="grid grid-cols-1 gap-3 sm:grid-cols-[9rem_minmax(0,1fr)]">
                  <h3 class="text-sm font-medium text-gray-500"><%= monthGroup.name %></h3>
                  <ul class="divide-y divide-dark-600 border-y border-dark-600">
                    <% monthGroup.posts.forEach(function(post) { %>
                      <li class="py-4">
                        <a href="/post/<%= post.slug %>" class="font-medium text-gray-200 hover:text-red-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-red-500"><%= post.title %></a>
                        <% if (post.excerpt) { %><p class="mt-1.5 text-sm text-gray-500"><%= post.excerpt %></p><% } %>
                        <time class="mt-2 block text-xs text-gray-600" datetime="<%= post.published_at || post.created_at %>"><%= new Date(post.published_at || post.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></time>
                      </li>
                    <% }) %>
                  </ul>
                </section>
              <% }) %>
            </div>
          </section>
        <% }) %>
      </div>
    <% } else { %>
      <section class="border-y border-dark-600 py-12 text-center">
        <h2 class="text-xl font-semibold text-white">No published posts yet</h2>
        <p class="mt-2 text-gray-400">Published articles will appear here.</p>
        <a href="/posts" class="mt-5 inline-flex border border-dark-500 px-4 py-2 text-sm text-gray-200 hover:bg-dark-700">Browse articles</a>
      </section>
    <% } %>
  </main>
  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>