<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-[#0a0a0a] text-gray-100 min-h-screen">
  <%- include('../../partials/admin-header') %>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <% if (error && error.length) { %><div role="alert" class="mb-5 border border-red-900 bg-red-950/50 px-4 py-3 text-sm text-red-200"><%= error %></div><% } %>
    <% if (success && success.length) { %><div role="status" class="mb-5 border border-green-900 bg-green-950/40 px-4 py-3 text-sm text-green-200"><%= success %></div><% } %>

    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-red-400">Content settings</p>
        <h1 class="text-3xl font-bold text-white">Categories</h1>
        <p class="mt-2 text-sm text-gray-400">Organize posts. Changes appear in navigation and the post editor automatically.</p>
      </div>
      <a href="/admin/posts/new" class="inline-flex items-center gap-2 px-4 py-2.5 bg-red-600 hover:bg-red-500 text-sm font-medium text-white rounded-md"><span class="material-icons text-base" aria-hidden="true">edit_note</span>Write a post</a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(250px,0.8fr)_minmax(0,1.6fr)] gap-8">
      <section class="border-y border-[#292929] py-6" aria-labelledby="create-category-title">
        <h2 id="create-category-title" class="text-lg font-semibold text-white">Add a category</h2>
        <form method="POST" action="/admin/categories" class="mt-5 space-y-5">
          <div>
            <label for="new-category-name" class="mb-2 block text-sm font-medium text-gray-300">Name</label>
            <input id="new-category-name" name="name" type="text" required maxlength="40" autocomplete="off" placeholder="e.g. Network Security" class="w-full border border-[#3a3a3a] bg-[#141414] px-3 py-2.5 text-white placeholder:text-gray-600 focus:border-red-500 focus:outline-none focus:ring-1 focus:ring-red-500">
            <p class="mt-2 text-xs text-gray-500">A clean URL is generated from this name.</p>
          </div>
          <div>
            <label for="new-category-color" class="mb-2 block text-sm font-medium text-gray-300">Label color</label>
            <div class="flex items-center gap-3">
              <input id="new-category-color" name="color" type="color" value="#6b7280" aria-label="Choose category label color" class="h-10 w-12 cursor-pointer border border-[#3a3a3a] bg-[#141414] p-1">
              <span class="text-xs text-gray-500">Used for category labels across the site.</span>
            </div>
          </div>
          <button type="submit" class="inline-flex w-full items-center justify-center gap-2 bg-red-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-red-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-400"><span class="material-icons text-base" aria-hidden="true">add</span>Add category</button>
        </form>
      </section>

      <section aria-labelledby="category-list-title">
        <div class="mb-4 flex items-center justify-between gap-4">
          <h2 id="category-list-title" class="text-lg font-semibold text-white">All categories</h2>
          <span class="text-sm text-gray-500"><%= categories.length %> total</span>
        </div>
        <% if (categories.length) { %>
          <ul class="divide-y divide-[#292929] border-y border-[#292929]">
            <% categories.forEach(function(category) { %>
              <li class="grid grid-cols-1 gap-4 py-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
                <form method="POST" action="/admin/categories/<%= category.id %>" class="grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-end">
                  <div>
                    <label for="category-name-<%= category.id %>" class="mb-1.5 block text-xs text-gray-500">Name</label>
                    <input id="category-name-<%= category.id %>" name="name" type="text" required maxlength="40" value="<%= category.name %>" class="w-full border border-[#333] bg-[#141414] px-3 py-2 text-sm text-white focus:border-red-500 focus:outline-none">
                    <p class="mt-1.5 text-xs text-gray-500">/<%= category.slug %> · <%= category.post_count %> <%= category.post_count === 1 ? 'post' : 'posts' %></p>
                  </div>
                  <div>
                    <label for="category-color-<%= category.id %>" class="mb-1.5 block text-xs text-gray-500">Color</label>
                    <input id="category-color-<%= category.id %>" name="color" type="color" value="<%= /^#[0-9a-f]{6}$/i.test(category.color || '') ? category.color : '#6b7280' %>" aria-label="Color for <%= category.name %>" class="h-9 w-12 cursor-pointer border border-[#333] bg-[#141414] p-1">
                  </div>
                  <button type="submit" class="inline-flex items-center gap-1.5 border border-[#444] px-3 py-2 text-sm text-gray-200 hover:border-gray-300 hover:text-white"><span class="material-icons text-base" aria-hidden="true">save</span>Save changes</button>
                </form>
                <form method="POST" action="/admin/categories/<%= category.id %>/delete" data-confirm="Delete this category? Its posts will become uncategorized.">
                  <button type="submit" class="inline-flex items-center gap-1 px-2 py-2 text-sm text-gray-500 hover:text-red-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-red-500"><span class="material-icons text-base" aria-hidden="true">delete</span>Delete</button>
                </form>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <div class="border-y border-[#292929] py-10 text-center">
            <p class="font-medium text-white">No categories yet</p>
            <p class="mt-2 text-sm text-gray-400">Add your first category to organize posts and populate site navigation.</p>
          </div>
        <% } %>
      </section>
    </div>
  </main>
</body>
</html>