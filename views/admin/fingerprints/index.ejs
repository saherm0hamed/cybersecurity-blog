<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-[#0a0a0a] text-gray-100 min-h-screen">
  <%- include('../../partials/admin-header') %>
  <main class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between gap-4 mb-6">
      <div>
        <h1 class="text-2xl font-bold">Post fingerprint insights</h1>
        <p class="text-sm text-gray-400">Visitor tracking data for each published post.</p>
      </div>
      <a href="/admin" class="inline-flex items-center gap-2 px-4 py-2 bg-[#1a1a1a] border border-[#333] hover:bg-[#222] rounded-lg text-sm"><span class="material-icons text-base" aria-hidden="true">arrow_back</span>Back to dashboard</a>
    </div>

    <% if (success && success.length) { %>
      <div role="status" class="mb-5 border border-green-900 bg-green-950/50 px-4 py-3 text-sm text-green-200"><%= success.join(' ') %></div>
    <% } %>
    <% if (error && error.length) { %>
      <div role="alert" class="mb-5 border border-red-900 bg-red-950/50 px-4 py-3 text-sm text-red-200"><%= error.join(' ') %></div>
    <% } %>

    <% if (posts.length === 0) { %>
      <div class="bg-[#1a1a1a] border border-[#222] rounded-xl p-6 text-sm text-gray-400">
        No published posts have created fingerprint entries yet.
      </div>
    <% } else { %>
      <div class="grid gap-6 lg:grid-cols-[320px_minmax(0,1fr)]">
        <aside class="bg-[#1a1a1a] border border-[#222] rounded-xl overflow-hidden">
          <div class="px-4 py-3 border-b border-[#222] text-sm font-semibold uppercase tracking-wider text-gray-400">
            Posts
          </div>
          <ul class="divide-y divide-[#222]">
            <% posts.forEach(function(post) { %>
              <li>
                <a href="/admin/fingerprints?post_id=<%= post.id %>" class="block px-4 py-3 hover:bg-[#161616] <%= selectedPost && selectedPost.id === post.id ? 'bg-[#161616]' : '' %>">
                  <div class="flex items-center justify-between gap-3">
                    <span class="font-medium text-white"><%= post.title %></span>
                    <span class="text-xs text-gray-400"><%= post.fingerprint_count || 0 %></span>
                  </div>
                  <div class="mt-1 text-xs text-gray-500">
                    <% if (post.last_seen) { %>
                      Last seen: <%= new Date(post.last_seen).toLocaleString() %>
                    <% } else { %>
                      No visits recorded
                    <% } %>
                  </div>
                </a>
              </li>
            <% }) %>
          </ul>
        </aside>

        <section class="bg-[#1a1a1a] border border-[#222] rounded-xl overflow-hidden">
          <% if (!selectedPost) { %>
            <div class="p-6 text-sm text-gray-400">Select a post from the list to inspect its visitor fingerprints.</div>
          <% } else { %>
            <div class="px-4 py-3 border-b border-[#222] bg-[#111] flex items-center justify-between gap-3">
              <div>
                <div class="text-xs uppercase tracking-wider text-gray-500">Selected post</div>
                <div class="font-semibold text-white"><%= selectedPost.title %></div>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-xs text-gray-400"><%= fingerprints.length %> record(s)</span>
                <a href="/admin/fingerprints/export?post_id=<%= selectedPost.id %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-red-600 hover:bg-red-500 text-white text-xs font-medium rounded-lg"><span class="material-icons text-base" aria-hidden="true">download</span>Export CSV</a>
                <form method="POST" action="/admin/fingerprints/post/<%= selectedPost.id %>/delete-all" data-confirm="Delete all fingerprint records for this post? This cannot be undone.">
                  <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-red-500/60 bg-red-500/10 text-red-300 text-xs font-medium rounded-lg hover:bg-red-500/20"><span class="material-icons text-base" aria-hidden="true">delete_sweep</span>Delete all</button>
                </form>
              </div>
            </div>

            <% if (fingerprints.length === 0) { %>
              <div class="p-6 text-sm text-gray-400">No fingerprint entries exist for this post yet.</div>
            <% } else { %>
              <div class="overflow-x-auto">
                <table class="min-w-full text-left text-sm">
                  <thead class="bg-[#111] text-gray-400">
                    <tr>
                      <th class="px-4 py-3">Visitor</th>
                      <th class="px-4 py-3">IP</th>
                      <th class="px-4 py-3">Browser</th>
                      <th class="px-4 py-3">Platform</th>
                      <th class="px-4 py-3">Screen</th>
                      <th class="px-4 py-3">Timezone</th>
                      <th class="px-4 py-3">Visited</th>
                      <th class="px-4 py-3">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% fingerprints.forEach(function(entry) { %>
                      <tr class="border-t border-[#222] align-top">
                        <td class="px-4 py-3 text-gray-200">
                          <div class="font-mono text-xs break-all text-red-400"><%= entry.visitor_id %></div>
                          <div class="mt-2 text-[11px] text-gray-500">Hash: <%= entry.fingerprint_hash.slice(0, 16) %></div>
                        </td>
                        <td class="px-4 py-3 text-gray-300">
                          <div class="font-mono text-xs break-all"><%= entry.visitor_ip || 'Unknown' %></div>
                          <div class="mt-1 text-[11px] text-gray-500">Hash: <%= entry.ip_hash ? entry.ip_hash.slice(0, 16) : 'N/A' %></div>
                        </td>
                        <td class="px-4 py-3 text-gray-300">
                          <div><%= entry.browser || 'Unknown' %></div>
                          <div class="mt-1 text-[11px] text-gray-500"><%= entry.user_agent ? entry.user_agent.slice(0, 80) : 'N/A' %></div>
                        </td>
                        <td class="px-4 py-3 text-gray-300"><%= entry.platform || 'Unknown' %></td>
                        <td class="px-4 py-3 text-gray-300"><%= entry.screen_resolution || 'N/A' %></td>
                        <td class="px-4 py-3 text-gray-300"><%= entry.timezone || 'N/A' %></td>
                        <td class="px-4 py-3 text-gray-300">
                          <div><%= new Date(entry.visited_at).toLocaleString() %></div>
                          <div class="mt-1 text-[11px] text-gray-500">Referrer: <%= entry.referrer ? entry.referrer.slice(0, 60) : 'N/A' %></div>
                        </td>
                        <td class="px-4 py-3">
                          <form method="POST" action="/admin/fingerprints/<%= entry.id %>/delete" data-confirm="Delete this fingerprint record?">
                            <button type="submit" class="inline-flex items-center gap-1 px-2.5 py-1.5 border border-red-500/60 bg-red-500/10 text-red-300 text-xs rounded-md hover:bg-red-500/20"><span class="material-icons text-base" aria-hidden="true">delete</span>Delete</button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          <% } %>
        </section>
      </div>
    <% } %>
  </main>
</body>
</html>
