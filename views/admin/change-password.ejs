<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Change Password · Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
  <style>
    * { box-sizing: border-box; }
    body { font-family: 'Inter', system-ui, sans-serif; background: #080a0c; color: #f3f4f6; min-height: 100dvh; display: flex; flex-direction: column; }

    .page-wrap { flex: 1; display: flex; align-items: flex-start; justify-content: center; padding: 3rem 1.25rem 4rem; }
    .card { width: 100%; max-width: 26rem; }

    /* FIX: was #374151 — invisible */
    .breadcrumb {
      display: flex; align-items: center; gap: 0.4rem;
      font-size: 0.75rem; color: #9ca3af;
      margin-bottom: 1rem; text-decoration: none; width: fit-content;
      transition: color 140ms ease;
    }
    .breadcrumb:hover { color: #f3f4f6; }
    .breadcrumb svg { flex-shrink: 0; }

    .page-header { margin-bottom: 2rem; }
    .page-title { font-size: 1.375rem; font-weight: 800; letter-spacing: -0.03em; color: #f3f4f6; line-height: 1.2; }
    /* FIX: was #ebeef3 — too bright/washed out */
    .page-sub { margin-top: 0.3rem; font-size: 0.8rem; color: #9ca3af; }

    .alert { display: flex; align-items: flex-start; gap: 0.65rem; padding: 0.75rem 0.9rem; border-radius: 0.5rem; font-size: 0.8rem; line-height: 1.5; margin-bottom: 1.5rem; }
    .alert svg { flex-shrink: 0; margin-top: 0.1rem; }
    .alert-error   { border: 1px solid rgba(217,0,0,0.3);    background: rgba(217,0,0,0.07);   color: #fca5a5; }
    .alert-success { border: 1px solid rgba(34,197,94,0.25); background: rgba(34,197,94,0.07); color: #86efac; }

    .form-card { background: #0d0f11; border: 1px solid #2d3138; border-radius: 0.875rem; padding: 1.75rem; }

    /* FIX: was #f5f6f8 — too bright */
    .field-section-label {
      font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em;
      text-transform: uppercase; color: #6b7280;
      margin-bottom: 0.85rem; padding-bottom: 0.65rem; border-bottom: 1px solid #2d3138;
    }

    .field-group { display: flex; flex-direction: column; gap: 1rem; }
    .field-group + .field-group { margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #2d3138; }

    /* FIX: was #f1f2f5 — too bright */
    .field label { display: block; font-size: 0.73rem; font-weight: 600; color: #d1d5db; margin-bottom: 0.4rem; }

    .field-wrap { position: relative; }

    /* FIX: was #b3b5b8 — jarring bright on dark */
    .field-icon {
      position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%);
      color: #6b7280; pointer-events: none; transition: color 140ms ease;
    }
    .field-wrap:focus-within .field-icon { color: #D90000; }

    .field input {
      width: 100%; padding: 0.625rem 2.5rem 0.625rem 2.35rem;
      background: #111315; border: 1px solid #2d3138;
      border-radius: 0.5rem; font-size: 0.875rem; color: #f3f4f6;
      outline: none; transition: border-color 140ms ease, box-shadow 140ms ease; -webkit-appearance: none;
    }
    /* FIX: was #738194 — inconsistent */
    .field input::placeholder { color: #4b5563; }
    .field input:focus { border-color: #D90000; box-shadow: 0 0 0 3px rgba(217,0,0,0.11); }

    .strength-bar-wrap { margin-top: 0.5rem; height: 3px; border-radius: 9999px; background: #1a1d20; overflow: hidden; }
    .strength-bar { height: 100%; border-radius: 9999px; width: 0%; transition: width 250ms ease, background-color 250ms ease; }
    /* FIX: was #374151 — invisible */
    .strength-hint { margin-top: 0.35rem; font-size: 0.68rem; color: #6b7280; min-height: 1em; transition: color 200ms ease; }

    .match-hint { margin-top: 0.35rem; font-size: 0.68rem; min-height: 1em; display: flex; align-items: center; gap: 0.3rem; }
    .match-hint svg { flex-shrink: 0; }

    /* FIX: was #1f2937 — invisible */
    .pw-toggle {
      position: absolute; right: 0.65rem; top: 50%; transform: translateY(-50%);
      color: #6b7280; background: none; border: none; cursor: pointer;
      padding: 0.2rem; border-radius: 0.25rem; display: flex; align-items: center;
      transition: color 140ms ease;
    }
    .pw-toggle:hover { color: #d1d5db; }
    .pw-toggle:focus-visible { outline: 2px solid #D90000; outline-offset: 2px; }

    .submit-btn {
      width: 100%; margin-top: 1.75rem; padding: 0.7rem 1rem; border-radius: 0.5rem;
      background: #D90000; color: #fff; font-size: 0.875rem; font-weight: 700;
      border: none; cursor: pointer; letter-spacing: 0.01em;
      display: flex; align-items: center; justify-content: center; gap: 0.5rem;
      transition: background-color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
    }
    .submit-btn:hover { background: #f01010; box-shadow: 0 4px 16px rgba(217,0,0,0.28); transform: translateY(-1px); }
    .submit-btn:active { transform: translateY(0); box-shadow: none; }
    .submit-btn:focus-visible { outline: 2px solid #D90000; outline-offset: 3px; }
    .submit-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; box-shadow: none; }

    .req-list { margin-top: 1.5rem; padding: 1rem 1.1rem; border-radius: 0.5rem; background: #0a0c0e; border: 1px solid #2d3138; }
    /* FIX: was #374151 — invisible */
    .req-list-label { font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: #6b7280; margin-bottom: 0.65rem; }
    /* FIX: was #374151 — invisible */
    .req-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; color: #9ca3af; padding: 0.2rem 0; transition: color 200ms ease; }
    .req-item.met { color: #4ade80; }
    .req-item svg { flex-shrink: 0; }
  </style>
</head>
<body>
  <%- include('../partials/admin-header') %>

  <main class="page-wrap">
    <div class="card">

      <a href="/admin" class="breadcrumb">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        Admin dashboard
      </a>

      <div class="page-header">
        <h1 class="page-title">Change password</h1>
        <p class="page-sub">Updates take effect immediately on save.</p>
      </div>

      <% if (typeof error !== 'undefined' && error.length) { %>
        <div class="alert alert-error" role="alert">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12" y2="16.01"/></svg>
          <%= error %>
        </div>
      <% } %>
      <% if (typeof success !== 'undefined' && success.length) { %>
        <div class="alert alert-success" role="status">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <%= success %>
        </div>
      <% } %>

      <form method="POST" action="/admin/change-password" id="change-pw-form" novalidate>
        <div class="form-card">

          <div class="field-group">
            <p class="field-section-label">Verify identity</p>
            <div class="field">
              <label for="current">Current password</label>
              <div class="field-wrap">
                <input id="current" type="password" name="current" required autocomplete="current-password" placeholder="••••••••">
                <svg class="field-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <button type="button" class="pw-toggle" data-target="current" aria-label="Show current password" aria-pressed="false">
                  <svg data-eye width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg data-eye-off width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                </button>
              </div>
            </div>
          </div>

          <div class="field-group">
            <p class="field-section-label">New password</p>

            <div class="field">
              <label for="new_password">New password</label>
              <div class="field-wrap">
                <input id="new_password" type="password" name="new_password" required minlength="8" autocomplete="new-password" placeholder="min. 8 characters" data-new-pw>
                <svg class="field-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                </svg>
                <button type="button" class="pw-toggle" data-target="new_password" aria-label="Show new password" aria-pressed="false">
                  <svg data-eye width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg data-eye-off width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                </button>
              </div>
              <div class="strength-bar-wrap" aria-hidden="true"><div class="strength-bar" id="strength-bar"></div></div>
              <p class="strength-hint" id="strength-hint" aria-live="polite"></p>
            </div>

            <div class="field">
              <label for="confirm">Confirm new password</label>
              <div class="field-wrap">
                <input id="confirm" type="password" name="confirm" required minlength="8" autocomplete="new-password" placeholder="repeat new password" data-confirm-pw>
                <svg class="field-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>
                </svg>
                <button type="button" class="pw-toggle" data-target="confirm" aria-label="Show confirm password" aria-pressed="false">
                  <svg data-eye width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg data-eye-off width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                </button>
              </div>
              <p class="match-hint" id="match-hint" aria-live="polite"></p>
            </div>
          </div>
        </div>

        <div class="req-list" aria-label="Password requirements">
          <p class="req-list-label">Requirements</p>
          <div class="req-item" id="req-length"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>At least 8 characters</div>
          <div class="req-item" id="req-upper"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>One uppercase letter</div>
          <div class="req-item" id="req-number"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>One number</div>
          <div class="req-item" id="req-special"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>One special character</div>
        </div>

        <button type="submit" class="submit-btn" id="submit-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Update password
        </button>
      </form>
    </div>
  </main>

  <script>
    document.querySelectorAll('.pw-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const input = document.getElementById(btn.dataset.target);
        const isHidden = input.type === 'password';
        input.type = isHidden ? 'text' : 'password';
        btn.setAttribute('aria-pressed', String(isHidden));
        btn.setAttribute('aria-label', (isHidden ? 'Hide' : 'Show') + ' ' + btn.closest('.field').querySelector('label').textContent.toLowerCase());
        btn.querySelector('[data-eye]').style.display    = isHidden ? 'none' : '';
        btn.querySelector('[data-eye-off]').style.display = isHidden ? '' : 'none';
      });
    });

    const newPwInput = document.querySelector('[data-new-pw]');
    const confirmInput = document.querySelector('[data-confirm-pw]');
    const bar = document.getElementById('strength-bar');
    const hint = document.getElementById('strength-hint');
    const matchHint = document.getElementById('match-hint');
    const submitBtn = document.getElementById('submit-btn');
    const reqLength = document.getElementById('req-length');
    const reqUpper  = document.getElementById('req-upper');
    const reqNumber = document.getElementById('req-number');
    const reqSpecial = document.getElementById('req-special');

    const CHECK_ICON = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
    const RING_ICON  = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>`;

    function scorePassword(pw) {
      const hasLength  = pw.length >= 8;
      const hasUpper   = /[A-Z]/.test(pw);
      const hasNumber  = /[0-9]/.test(pw);
      const hasSpecial = /[^A-Za-z0-9]/.test(pw);
      let score = [hasLength, hasUpper, hasNumber, hasSpecial].filter(Boolean).length;
      if (pw.length >= 12) score++;
      reqLength.classList.toggle('met', hasLength);  reqLength.innerHTML  = (hasLength  ? CHECK_ICON : RING_ICON) + ' At least 8 characters';
      reqUpper.classList.toggle('met', hasUpper);    reqUpper.innerHTML   = (hasUpper   ? CHECK_ICON : RING_ICON) + ' One uppercase letter';
      reqNumber.classList.toggle('met', hasNumber);  reqNumber.innerHTML  = (hasNumber  ? CHECK_ICON : RING_ICON) + ' One number';
      reqSpecial.classList.toggle('met', hasSpecial);reqSpecial.innerHTML = (hasSpecial ? CHECK_ICON : RING_ICON) + ' One special character';
      return { score, hasLength };
    }

    const levels = [
      { w: '0%',   bg: 'transparent', label: '' },
      { w: '25%',  bg: '#D90000',     label: 'Weak' },
      { w: '50%',  bg: '#f97316',     label: 'Fair' },
      { w: '75%',  bg: '#eab308',     label: 'Good' },
      { w: '100%', bg: '#22c55e',     label: 'Strong' },
    ];

    newPwInput.addEventListener('input', () => {
      const pw = newPwInput.value;
      const { score } = scorePassword(pw);
      const level = pw.length === 0 ? 0 : Math.min(score, 4);
      bar.style.width = levels[level].w;
      bar.style.backgroundColor = levels[level].bg;
      hint.textContent = pw.length ? levels[level].label : '';
      hint.style.color = levels[level].bg;
      updateMatch(); updateSubmit();
    });
    confirmInput.addEventListener('input', () => { updateMatch(); updateSubmit(); });

    function updateMatch() {
      const nv = newPwInput.value, cv = confirmInput.value;
      if (!cv) { matchHint.innerHTML = ''; return; }
      if (nv === cv) {
        matchHint.style.color = '#4ade80';
        matchHint.innerHTML = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Passwords match`;
      } else {
        matchHint.style.color = '#D90000';
        matchHint.innerHTML = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> Passwords don't match`;
      }
    }
    function updateSubmit() {
      const nv = newPwInput.value, cv = confirmInput.value;
      const { score } = scorePassword(nv);
      submitBtn.disabled = !(nv === cv && nv.length >= 8 && score >= 2);
    }
    updateSubmit();
  </script>
  <script src="/js/main.js"></script>
</body>
</html>