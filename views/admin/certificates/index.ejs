<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Certificates | Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-[#0a0a0a] text-gray-100 min-h-screen">
  <%- include('../../partials/admin-header') %>
  <main class="max-w-7xl mx-auto px-4 py-8">
    <% if (typeof success !== 'undefined' && success.length) { %><div class="mb-4 p-3 bg-green-900/40 border border-green-700 text-green-300 rounded-lg text-sm"><%= success %></div><% } %>
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold">Certificates</h1>
      <a href="/admin/certificates/new" class="inline-flex items-center gap-2 px-4 py-2 bg-red-600 hover:bg-red-500 text-white text-sm font-medium rounded-lg"><span class="material-icons text-base" aria-hidden="true">add</span>Add</a>
    </div>
    <div class="bg-[#1a1a1a] border border-[#222] rounded-xl overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-[#111] text-gray-400 text-left"><tr><th class="px-4 py-3">Title</th><th class="px-4 py-3">Issuer</th><th class="px-4 py-3">Date</th><th class="px-4 py-3">Actions</th></tr></thead>
        <tbody>
          <% certificates.forEach(function(c) { %>
            <tr class="border-t border-[#222]">
              <td class="px-4 py-3"><%= c.title %></td>
              <td class="px-4 py-3 text-gray-400"><%= c.issuer %></td>
              <td class="px-4 py-3 text-gray-500"><%= c.obtained_date || '—' %></td>
              <td class="px-4 py-3 space-x-2">
                <a href="/admin/certificates/<%= c.id %>/edit" class="inline-flex items-center gap-1 text-red-500 hover:underline"><span class="material-icons text-base" aria-hidden="true">edit</span>Edit</a>
                <form method="POST" action="/admin/certificates/<%= c.id %>/delete" class="inline" data-confirm="Delete this certificate? This action cannot be undone."><button type="submit" class="inline-flex items-center gap-1 text-gray-500 hover:text-red-400"><span class="material-icons text-base" aria-hidden="true">delete</span>Delete</button></form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
