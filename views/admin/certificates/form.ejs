<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-[#0a0a0a] text-gray-100 min-h-screen">
  <%- include('../../partials/admin-header') %>
  <main class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6"><%= title %></h1>
    <form method="POST" action="<%= cert ? '/admin/certificates/' + cert.id : '/admin/certificates' %>" enctype="multipart/form-data" class="space-y-4">
      <div><label class="block text-sm text-gray-400 mb-1">Title *</label><input type="text" name="title" required value="<%= cert ? cert.title : '' %>" class="w-full bg-[#1a1a1a] border border-[#333] rounded-lg px-3 py-2 text-white"></div>
      <div><label class="block text-sm text-gray-400 mb-1">Issuer</label><input type="text" name="issuer" value="<%= cert ? cert.issuer || '' : '' %>" class="w-full bg-[#1a1a1a] border border-[#333] rounded-lg px-3 py-2 text-white"></div>
      <div><label class="block text-sm text-gray-400 mb-1">Date Obtained</label><input type="date" name="obtained_date" value="<%= cert ? cert.obtained_date || '' : '' %>" class="w-full bg-[#1a1a1a] border border-[#333] rounded-lg px-3 py-2 text-white"></div>
      <div><label class="block text-sm text-gray-400 mb-1">Description</label><textarea name="description" rows="3" class="w-full bg-[#1a1a1a] border border-[#333] rounded-lg px-3 py-2 text-white"><%= cert ? cert.description || '' : '' %></textarea></div>
      <div><label class="block text-sm text-gray-400 mb-1">Verification URL</label><input type="url" name="verification_url" value="<%= cert ? cert.verification_url || '' : '' %>" class="w-full bg-[#1a1a1a] border border-[#333] rounded-lg px-3 py-2 text-white"></div>
      <div><label class="block text-sm text-gray-400 mb-1">Category</label><input type="text" name="category" value="<%= cert ? cert.category || '' : '' %>" class="w-full bg-[#1a1a1a] border border-[#333] rounded-lg px-3 py-2 text-white"></div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Image / Logo</label>
        <% if (cert && cert.image) { %><input type="hidden" name="existing_image" value="<%= cert.image %>"><p class="text-xs text-gray-500 mb-1">Current: <%= cert.image %></p><% } %>
        <input type="file" name="image" accept="image/*" class="text-sm text-gray-400">
      </div>
      <div class="flex gap-3 pt-2">
        <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium rounded-lg"><span class="material-icons text-base" aria-hidden="true">save</span>Save</button>
        <a href="/admin/certificates" class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#1a1a1a] border border-[#333] rounded-lg text-gray-300"><span class="material-icons text-base" aria-hidden="true">close</span>Cancel</a>
      </div>
    </form>
  </main>
</body>
</html>
