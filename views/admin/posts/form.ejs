<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-[#0a0a0a] text-gray-100 min-h-screen">
  <%- include('../../partials/admin-header') %>
  <main class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6"><%= title %></h1>
    <form method="POST" action="<%= post ? '/admin/posts/' + post.id : '/admin/posts' %>" enctype="multipart/form-data" class="space-y-5">
      <div>
        <label class="block text-sm text-gray-400 mb-1">Title *</label>
        <input type="text" name="title" required value="<%= post ? post.title : '' %>" class="w-full bg-[#1a1a1a] border border-[#333] rounded-lg px-3 py-2 text-white focus:outline-none focus:ring-1 focus:ring-red-500">
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Excerpt</label>
        <textarea name="excerpt" rows="2" class="w-full bg-[#1a1a1a] border border-[#333] rounded-lg px-3 py-2 text-white focus:outline-none focus:ring-1 focus:ring-red-500"><%= post ? post.excerpt || '' : '' %></textarea>
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Content (Markdown)</label>
        <textarea name="content" rows="16" class="w-full bg-[#1a1a1a] border border-[#333] rounded-lg px-3 py-2 text-white font-mono text-sm focus:outline-none focus:ring-1 focus:ring-red-500"><%= post ? post.content || '' : '' %></textarea>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm text-gray-400 mb-1">Category</label>
          <select name="category_id" class="w-full bg-[#1a1a1a] border border-[#333] rounded-lg px-3 py-2 text-white focus:outline-none focus:ring-1 focus:ring-red-500">
            <option value="">— None —</option>
            <% categories.forEach(function(c) { %>
              <option value="<%= c.id %>" <%= post && post.category_id == c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
          <% if (!categories.length) { %>
            <p class="mt-2 text-xs text-gray-500">No categories yet. <a href="/admin/categories" class="text-red-400 hover:underline">Create one</a>.</p>
          <% } %>
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Author</label>
          <input type="text" name="author" value="<%= post ? post.author : 'Admin' %>" class="w-full bg-[#1a1a1a] border border-[#333] rounded-lg px-3 py-2 text-white focus:outline-none focus:ring-1 focus:ring-red-500">
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm text-gray-400 mb-1">Status</label>
          <select name="status" class="w-full bg-[#1a1a1a] border border-[#333] rounded-lg px-3 py-2 text-white focus:outline-none focus:ring-1 focus:ring-red-500">
            <option value="draft" <%= post && post.status === 'draft' ? 'selected' : '' %>>Draft</option>
            <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>Published</option>
          </select>
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Cover Image</label>
          <% if (post && post.cover_image) { %>
            <input type="hidden" name="existing_cover" value="<%= post.cover_image %>">
            <p class="text-xs text-gray-500 mb-1">Current: <%= post.cover_image %></p>
          <% } %>
          <input type="file" name="cover_image" accept="image/*" class="w-full text-sm text-gray-400">
          <p class="mt-2 text-xs text-gray-500">This post’s uploads are stored in <code>public/uploads/posts/<%= post ? post.id : 'post-id' %>/</code>.</p>
        </div>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium rounded-lg"><span class="material-icons text-base" aria-hidden="true">save</span>Save</button>
        <a href="/admin/posts" class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#1a1a1a] border border-[#333] rounded-lg text-gray-300 hover:bg-[#222]"><span class="material-icons text-base" aria-hidden="true">close</span>Cancel</a>
      </div>
    </form>
  </main>
</body>
</html>
