<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login · sahermØhamed</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
  <style>
    * { box-sizing: border-box; }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: #080a0c;
      min-height: 100dvh;
      display: grid;
      grid-template-columns: 1fr;
      overflow: hidden;
    }
    @media (min-width: 900px) {
      body { grid-template-columns: 1fr 1fr; }
    }

    /* ── Left panel ── */
    .brand-panel {
      display: none;
      position: relative;
      background: #0d0f11;
      border-right: 1px solid #1e2126;
      overflow: hidden;
      padding: 3rem;
      flex-direction: column;
      justify-content: space-between;
    }
    @media (min-width: 900px) { .brand-panel { display: flex; } }

    .brand-panel::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
    }
    .brand-panel::after {
      content: '';
      position: absolute;
      bottom: -8rem; left: -4rem;
      width: 28rem; height: 28rem;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(217,0,0,0.12) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }
    .brand-panel > * { position: relative; z-index: 1; }

    .brand-logo {
      font-size: 1.05rem; font-weight: 800; letter-spacing: -0.02em;
      color: #f3f4f6; text-decoration: none;
    }
    .brand-logo span { color: #D90000; }

    .brand-headline {
      font-size: clamp(1.75rem, 3vw, 2.4rem);
      font-weight: 800; letter-spacing: -0.04em; line-height: 1.15; color: #f3f4f6;
    }
    .brand-headline em { font-style: normal; color: #D90000; }

    .brand-subtext {
      margin-top: 1rem; font-size: 0.8125rem; line-height: 1.65;
      color: #9ca3af; max-width: 28ch;
    }

    .brand-grid {
      position: absolute; inset: 0; z-index: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
      background-size: 3rem 3rem;
      -webkit-mask-image: linear-gradient(to bottom, transparent, black 30%, black 70%, transparent);
      mask-image: linear-gradient(to bottom, transparent, black 30%, black 70%, transparent);
    }

    .status-row { display: flex; flex-direction: column; gap: 0.6rem; }
    .status-chip {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.45rem 0.75rem; border-radius: 0.375rem;
      border: 1px solid #2d3138; background: #111315;
      font-size: 0.75rem; color: #9ca3af; width: fit-content;
    }
    .status-chip-dot {
      width: 0.45rem; height: 0.45rem; border-radius: 50%;
      background: #22c55e; box-shadow: 0 0 6px rgba(34,197,94,0.6); flex-shrink: 0;
    }
    .status-chip-dot.red { background: #D90000; box-shadow: 0 0 6px rgba(217,0,0,0.5); }

    /* ── Right panel ── */
    .form-panel {
      display: flex; align-items: center; justify-content: center;
      padding: 2rem 1.5rem; background: #080a0c; position: relative;
    }
    .form-inner { width: 100%; max-width: 22rem; }

    .mobile-wordmark {
      display: block; text-align: center;
      font-size: 1rem; font-weight: 800; letter-spacing: -0.02em;
      color: #f3f4f6; margin-bottom: 2.5rem;
    }
    .mobile-wordmark span { color: #D90000; }
    @media (min-width: 900px) { .mobile-wordmark { display: none; } }

    .form-heading {
      font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em;
      color: #f3f4f6; margin-bottom: 0.3rem;
    }
    /* FIX: was #4b5563 — invisible */
    .form-sub { font-size: 0.8rem; color: #9ca3af; margin-bottom: 2rem; }

    .error-banner {
      display: flex; align-items: flex-start; gap: 0.6rem;
      padding: 0.75rem 0.875rem; border-radius: 0.5rem;
      border: 1px solid rgba(217,0,0,0.3); background: rgba(217,0,0,0.07);
      margin-bottom: 1.25rem; font-size: 0.8rem; color: #fca5a5; line-height: 1.5;
    }
    .error-banner svg { flex-shrink: 0; margin-top: 0.05rem; }

    .field-group { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem; }

    .field label {
      display: block; font-size: 0.75rem; font-weight: 600;
      /* FIX: was #6b7280 — readable but bumped up */
      color: #d1d5db; margin-bottom: 0.45rem; letter-spacing: 0.01em;
    }
    .field-input-wrap { position: relative; }

    /* FIX: was #374151 — invisible */
    .field-icon {
      position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%);
      color: #6b7280; pointer-events: none; transition: color 150ms ease;
    }
    .field input {
      width: 100%; padding: 0.65rem 0.875rem 0.65rem 2.4rem;
      background: #111315; border: 1px solid #2d3138;
      border-radius: 0.5rem; font-size: 0.875rem; color: #f3f4f6;
      outline: none; transition: border-color 150ms ease, box-shadow 150ms ease;
      -webkit-appearance: none;
    }
    /* FIX: was #374151 — invisible */
    .field input::placeholder { color: #4b5563; }
    .field input:focus { border-color: #D90000; box-shadow: 0 0 0 3px rgba(217,0,0,0.12); }
    .field-input-wrap:focus-within .field-icon { color: #D90000; }

    /* FIX: was #374151 — invisible */
    .pw-toggle {
      position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%);
      color: #6b7280; background: none; border: none; cursor: pointer;
      padding: 0.15rem; border-radius: 0.25rem;
      transition: color 150ms ease; display: flex; align-items: center;
    }
    .pw-toggle:hover { color: #d1d5db; }
    .pw-toggle:focus-visible { outline: 2px solid #D90000; outline-offset: 2px; }
    .field input[type="password"], .field input[data-pw] { padding-right: 2.5rem; }

    .submit-btn {
      width: 100%; padding: 0.7rem 1rem; border-radius: 0.5rem;
      background: #D90000; color: #fff; font-size: 0.875rem; font-weight: 700;
      border: none; cursor: pointer; letter-spacing: 0.01em;
      transition: background-color 150ms ease, transform 150ms ease, box-shadow 150ms ease;
      display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    }
    .submit-btn:hover { background: #f01010; box-shadow: 0 4px 16px rgba(217,0,0,0.3); transform: translateY(-1px); }
    .submit-btn:active { transform: translateY(0); }
    .submit-btn:focus-visible { outline: 2px solid #D90000; outline-offset: 3px; }

    /* FIX: was #374151 — invisible */
    .back-link {
      display: inline-flex; align-items: center; gap: 0.35rem;
      margin-top: 1.75rem; font-size: 0.75rem;
      color: #6b7280; text-decoration: none; transition: color 150ms ease;
    }
    .back-link:hover { color: #d1d5db; }
  </style>
</head>
<body>

  <aside class="brand-panel" aria-hidden="true">
    <div class="brand-grid"></div>
    <a href="/" class="brand-logo">saherm<span>Ø</span>hamed</a>
    <div>
      <h1 class="brand-headline">Control<br><em>center.</em></h1>
      <p class="brand-subtext">Manage posts, projects, and certificates from one place.</p>
    </div>
    <div class="status-row">
      <div class="status-chip"><span class="status-chip-dot"></span>Blog online</div>
      <div class="status-chip"><span class="status-chip-dot red"></span>Restricted access</div>
    </div>
  </aside>

  <main class="form-panel">
    <div class="form-inner">
      <span class="mobile-wordmark">saherm<span>Ø</span>hamed</span>
      <h2 class="form-heading">Sign in</h2>
      <p class="form-sub">Admin access only</p>

      <% if (typeof error !== 'undefined' && error.length) { %>
        <div class="error-banner" role="alert">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12" y2="16.01"/>
          </svg>
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/admin/login" novalidate>
        <div class="field-group">
          <div class="field">
            <label for="username">Username</label>
            <div class="field-input-wrap">
              <input id="username" type="text" name="username" required autofocus
                autocomplete="username" placeholder="your username"
                spellcheck="false" autocapitalize="none">
              <svg class="field-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
          </div>
          <div class="field">
            <label for="password">Password</label>
            <div class="field-input-wrap">
              <input id="password" type="password" name="password" required
                autocomplete="current-password" placeholder="••••••••" data-pw>
              <svg class="field-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <button type="button" class="pw-toggle" id="pw-toggle" aria-label="Show password" aria-pressed="false">
                <svg id="pw-icon-show" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                </svg>
                <svg id="pw-icon-hide" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:none">
                  <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                  <line x1="1" y1="1" x2="23" y2="23"/>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <button type="submit" class="submit-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/>
          </svg>
          Sign in
        </button>
      </form>

      <a href="/" class="back-link">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        Back to blog
      </a>
    </div>
  </main>

  <script>
    const toggle = document.getElementById('pw-toggle');
    const pwInput = document.getElementById('password');
    const iconShow = document.getElementById('pw-icon-show');
    const iconHide = document.getElementById('pw-icon-hide');
    toggle.addEventListener('click', () => {
      const isHidden = pwInput.type === 'password';
      pwInput.type = isHidden ? 'text' : 'password';
      toggle.setAttribute('aria-pressed', String(isHidden));
      toggle.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
      iconShow.style.display = isHidden ? 'none' : '';
      iconHide.style.display = isHidden ? '' : 'none';
    });
  </script>
  <script src="/js/main.js"></script>
</body>
</html>