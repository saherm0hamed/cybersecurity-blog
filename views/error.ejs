<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-[#0a0a0a] text-gray-100 min-h-screen flex items-center justify-center">
  <div class="text-center px-4">
    <h1 class="text-4xl font-bold text-red-500 mb-4">Error</h1>
    <p class="text-gray-400 mb-8"><%= typeof message !== 'undefined' ? message : 'Something went wrong' %></p>
    <a href="/" class="inline-flex px-6 py-3 bg-red-600 hover:bg-red-500 text-white font-medium rounded-lg">Back to Home</a>
  </div>
  <%- include('partials/back-to-top') %>
  <script src="/js/main.js"></script>
</body>
</html>
