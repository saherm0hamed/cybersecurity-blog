<header class="site-navbar sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">

      <!-- ── Logo ── -->
      <a href="/" class="flex items-center gap-2 shrink-0" aria-label="<%= siteName %> home">
        <img src="/favicon-32x32.png" alt="" width="26" height="26" class="rounded-sm" aria-hidden="true">
        <span class="nav-logo-wordmark">
          <span>saherm</span><span class="logo-accent">Ø</span>hamed
        </span>
      </a>

      <!-- ── Desktop nav ── -->
      <nav class="hidden md:flex items-center gap-0.5" aria-label="Primary navigation">
        <a href="/"
           class="nav-link <%= currentPath === '/' ? 'is-active' : '' %>">Home</a>
        <a href="/posts"
           class="nav-link <%= currentPath.startsWith('/posts') || currentPath.startsWith('/post') ? 'is-active' : '' %>">Posts</a>
        <a href="/archive"
           class="nav-link <%= currentPath.startsWith('/archive') ? 'is-active' : '' %>">Archive</a>
        <a href="/about"
           class="nav-link <%= currentPath === '/about' ? 'is-active' : '' %>">About</a>
        <% if (admin) { %>
          <a href="/admin" class="nav-admin-pill ml-2">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
            Admin
          </a>
        <% } %>
      </nav>

      <!-- ── Right controls ── -->
      <div class="flex items-center gap-2 ml-auto md:ml-0">

        <!-- Search (hidden on xs) -->
        <form action="/search" method="GET" class="hidden sm:block" role="search">
          <label for="nav-search" class="sr-only">Search articles</label>
          <div class="nav-search-wrap">
            <svg class="nav-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/>
            </svg>
            <input
              id="nav-search"
              type="search"
              name="q"
              class="nav-search-input"
              placeholder="Search…"
              autocomplete="off"
              spellcheck="false">
          </div>
        </form>

        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          type="button"
          class="theme-toggle"
          role="switch"
          aria-checked="true"
          aria-label="Switch to light mode"
          title="Toggle theme">
          <span class="sr-only">Toggle dark mode</span>
          <!-- Sun icon (visible in dark) -->
          <span aria-hidden="true" class="absolute left-1.5 text-amber-300 flex items-center">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4"/>
              <path stroke-linecap="round" d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/>
            </svg>
          </span>
          <!-- Moon icon (visible in light) -->
          <span aria-hidden="true" class="absolute right-1.5 text-slate-400 flex items-center">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/>
            </svg>
          </span>
          <span id="theme-toggle-thumb" class="theme-toggle-thumb" aria-hidden="true"></span>
        </button>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="mobile-menu-btn md:hidden"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- ── Mobile menu ── -->
  <div id="mobile-menu" hidden class="mobile-menu-panel md:hidden">
    <div class="max-w-7xl mx-auto px-4 pb-4 pt-2 space-y-0.5">
      <a href="/"       class="mobile-nav-link <%= currentPath === '/' ? 'is-active' : '' %>">Home</a>
      <a href="/posts"  class="mobile-nav-link <%= currentPath.startsWith('/posts') || currentPath.startsWith('/post') ? 'is-active' : '' %>">Posts</a>
      <a href="/archive" class="mobile-nav-link <%= currentPath.startsWith('/archive') ? 'is-active' : '' %>">Archive</a>
      <a href="/about"  class="mobile-nav-link <%= currentPath === '/about' ? 'is-active' : '' %>">About</a>
      <% if (admin) { %>
        <a href="/admin" class="mobile-nav-link mt-1 font-semibold" style="color: var(--accent);">Admin</a>
      <% } %>

      <!-- Mobile search -->
      <form action="/search" method="GET" class="pt-3" role="search">
        <label for="mobile-search" class="sr-only">Search articles</label>
        <div class="nav-search-wrap">
          <svg class="nav-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/>
          </svg>
          <input
            id="mobile-search"
            type="search"
            name="q"
            class="nav-search-input"
            style="width: 100%"
            placeholder="Search articles…"
            autocomplete="off">
        </div>
      </form>
    </div>
  </div>
</header>
